# Pooled connection (Vercel Postgres: use POSTGRES_PRISMA_URL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct connection for migrations (Vercel Postgres: use POSTGRES_URL_NON_POOLING)
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

AUTH_SECRET="change-this-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
AGENT_APP_URL="http://localhost:3002"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Option A (recommended on Vercel): unsigned upload preset — no API key upload role needed
CLOUDINARY_UPLOAD_PRESET="utg-allscore-unsigned"
# Option B: signed uploads — API key must have Upload permission in Cloudinary Console
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# One-time production seed via POST /api/setup/seed with header x-setup-secret
SETUP_SECRET="change-this-before-deploy"
