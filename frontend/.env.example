# Pooled connection — Neon "pooled" URL (host contains -pooler)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — Neon "direct" URL (same host WITHOUT -pooler). Required for migrations.
# In Vercel: add both DATABASE_URL and DIRECT_URL as environment variables.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="change-this-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
AGENT_APP_URL="http://localhost:3002"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# One-time production seed via POST /api/setup/seed with header x-setup-secret
SETUP_SECRET="change-this-before-deploy"
